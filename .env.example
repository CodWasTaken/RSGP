# Set these in Vercel or .env.local. Never expose service role or AI keys to the browser.
# Reused and restored RSGP Supabase project (public URL, not a secret).
NEXT_PUBLIC_SUPABASE_URL=https://qznmxbwhotgwmcrskdtd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Server-side image provider; one low-quality PNG per explicit click.
RSGP_IMAGE_MODEL=gpt-image-1-mini
NEXT_PUBLIC_RSGP_ORIGIN=

# Optional Roblox OAuth app for per-creator Image uploads (Roblox beta).
# Register redirect URI: https://YOUR-RSGP-ORIGIN/api/roblox/callback
# Authorize scopes: openid, profile, asset:read, asset:write
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this stable; rotating without migration invalidates existing encrypted tokens.
RSGP_TOKEN_ENCRYPTION_KEY=
